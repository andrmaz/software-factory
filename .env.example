# Filled in by `npm create factory`. For a manual setup, copy them from your Mastra platform project.
# MASTRA_PLATFORM_SECRET_KEY=
# MASTRA_PLATFORM_ACCESS_TOKEN= (alternative to MASTRA_PLATFORM_SECRET_KEY)
# Restrict Factory sign-in to the organization that owns this deployment.
# MASTRA_ORGANIZATION_ID=
# MASTRA_PROJECT_ID=
# MASTRA_ENVIRONMENT_ID=

# Keep MASTRA_PLATFORM_STUDIO_AUTH unset: hosted Studio requires platform
# organization membership by default. Do not set it to disabled.
# Factory also supplies server.auth and studio.auth through factory.prepare().
# CLI login / MASTRA_API_TOKEN is separate from the runtime credentials above.

# PostgreSQL with pgvector. Filled in by `npm create factory`.
# DATABASE_URL=

# Public URL of this server. Defaults to http://localhost:4111 locally.
# In production, use the actual HTTPS Factory URL reported by the platform.
# MASTRACODE_PUBLIC_URL=

# Optional Slack: set bot token, client ID/secret, signing secret (or app token), and an HTTPS public URL for linking.
# SLACK_APP_SIGNING_SECRET=
# SLACK_APP_TOKEN=
# SLACK_APP_BOT_TOKEN=
# SLACK_APP_CLIENT_ID=
# SLACK_APP_CLIENT_SECRET=
# MASTRACODE_CHANNELS_PUBLIC_URL=

# Encrypts stored credentials. Generated by `npm create factory` (or `openssl rand -base64 32`).
# Keep it stable and backed up: losing it makes stored credentials unreadable.
# FACTORY_CREDENTIAL_ENCRYPTION_KEY=
